void loop() {
  int vibrationDetected = digitalRead(vib_pin);
  Serial.print("📡 Vibration Pin Value: ");
  Serial.println(vibrationDetected);

  if (vibrationDetected == HIGH) {
    Serial.println("\n⚠️ Vibration detected!");
    delay(2000); // wait 2 sec before reading GPS

    String lat = "";
    String lon = "";

    unsigned long startTime = millis();
    bool gotFix = false;

    while (millis() - startTime < 5000) {
      if (gpsSerial.available()) {
        String gpsLine = gpsSerial.readStringUntil('\n');
        Serial.print("🔎 Raw GPS: ");
        Serial.println(gpsLine);

        if (gpsLine.startsWith("$GPRMC")) {
          char buffer[100];
          gpsLine.toCharArray(buffer, sizeof(buffer));
          char* tokens[12];
          char* token = strtok(buffer, ",");
          int index = 0;

          while (token != NULL && index < 12) {
            tokens[index++] = token;
            token = strtok(NULL, ",");
          }

          if (index >= 7 && strcmp(tokens[2], "A") == 0) {
            lat = convertToDecimal(tokens[3], tokens[4]);
            lon = convertToDecimal(tokens[5], tokens[6]);
            gotFix = true;
            break;
          } else {
            Serial.println("❌ Invalid GPS fix.");
          }
        }
      }
    }

    if (gotFix && lat != "" && lon != "") {
      Serial.println("📍 Valid GPS Coordinates:");
      Serial.print("Latitude: ");
      Serial.println(lat);
      Serial.print("Longitude: ");
      Serial.println(lon);
      sendToSalesforce(lat, lon);
    } else {
      Serial.println("❌ No valid GPS data after timeout.");
      Serial.println("⏳ Waiting 20 seconds before sending fallback coordinates...");
      delay(20000);

      String fallbackLat = "13.063358504531184";
      String fallbackLon = "77.47491462300071";

      Serial.println("📍 Sending fallback coordinates:");
      Serial.print("Latitude: ");
      Serial.println(fallbackLat);
      Serial.print("Longitude: ");
      Serial.println(fallbackLon);
      sendToSalesforce(fallbackLat, fallbackLon);
    }

    delay(5000);
  }
}

String convertToDecimal(const char* raw, const char* direction) {
  if (strlen(raw) < 6) return "";

  double rawVal = atof(raw);
  int degrees = (int)(rawVal / 100);
  double minutes = rawVal - (degrees * 100);
  double decimal = degrees + (minutes / 60.0);

  if (direction[0] == 'S' || direction[0] == 'W') {
    decimal *= -1;
  }

  String result = String(decimal, 6);
  Serial.print("📐 Converted NMEA to Decimal: ");
  Serial.println(result);
  return result;
}

void getAccessToken() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    WiFiClientSecure client;
    client.setInsecure(); // 👈 Trust all certs

    Serial.println("🔐 Requesting Access Token...");

    http.begin(client, token_url);
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");

    String body = "grant_type=client_credentials";
    body += "&client_id=" + String(client_id);
    body += "&client_secret=" + String(client_secret);

    Serial.print("📤 OAuth Request Body: ");
    Serial.println(body);

    int code = http.POST(body);
    Serial.print("🔢 Token Response Code: ");
    Serial.println(code);

    if (code == 200) {
      String payload = http.getString();
      Serial.print("📨 Token Response: ");
      Serial.println(payload);

      int tokenIndex = payload.indexOf("access_token\":\"") + 15;
      int endQuote = payload.indexOf("\"", tokenIndex);
      accessToken = payload.substring(tokenIndex, endQuote);
      Serial.print("✅ Access Token: ");
      Serial.println(accessToken);
    } else {
      Serial.println("❌ Failed to obtain access token.");
    }

    http.end();
  } else {
    Serial.println("🚫 WiFi not connected for token request.");
  }
}

