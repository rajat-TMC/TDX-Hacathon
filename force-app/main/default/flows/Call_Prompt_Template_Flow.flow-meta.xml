    <formulas>
        <name>emailBody</name>
        <dataType>String</dataType>
        <expression>TRIM(
  MID(
    {!response},
    FIND(&apos;&quot;body&quot;: &quot;&apos;, {!response}) + 9,
    LEN({!response}) - FIND(&apos;&quot;body&quot;: &quot;&apos;, {!response}) - 10
  )
)</expression>
    </formulas>
    <formulas>
        <name>emailSubject</name>
        <dataType>String</dataType>
        <expression>MID(
  {!response},
  FIND(&apos;&quot;subject&quot;: &quot;&apos;, {!response}) + 12,
  FIND(&apos;&quot;,&apos;, {!response}, FIND(&apos;&quot;subject&quot;: &quot;&apos;, {!response})) - (FIND(&apos;&quot;subject&quot;: &quot;&apos;, {!response}) + 12)
)</expression>
    </formulas>
